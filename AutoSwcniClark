--// PLAYER MOVEMENT - WAR + RACE
--// Continuous Tween Follow
--// No Anchored / No WeldConstraint

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local TWEEN_SPEED = 90
local FOLLOW_DISTANCE = 3

-- How long WAR follows each player
local WAR_FOLLOW_TIME = 2

-- How often the destination is refreshed
local UPDATE_INTERVAL = 0.08

--==================================================
-- STATE
--==================================================

local WarEnabled = false
local RaceEnabled = false

local CurrentWarTarget = nil
local CurrentRaceTarget = nil

local ActiveTween = nil

--==================================================
-- CHARACTER FUNCTIONS
--==================================================

local function GetCharacter(player)
    if not player then
        return nil, nil, nil
    end

    local character = player.Character
    if not character then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return nil, nil, nil
    end

    if humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function GetLocalCharacter()
    return GetCharacter(LocalPlayer)
end

local function IsValidPlayer(player)
    if not player or player == LocalPlayer then
        return false
    end

    local character, humanoid, root = GetCharacter(player)

    return character ~= nil
        and humanoid ~= nil
        and root ~= nil
        and humanoid.Health > 0
end

--==================================================
-- FIND NEAREST PLAYER
--==================================================

local function GetNearestPlayer()
    local _, _, myRoot = GetLocalCharacter()

    if not myRoot then
        return nil
    end

    local nearestPlayer = nil
    local nearestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if IsValidPlayer(player) then
            local _, _, targetRoot = GetCharacter(player)

            if targetRoot then
                local distance = (myRoot.Position - targetRoot.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestPlayer = player
                end
            end
        end
    end

    return nearestPlayer
end

--==================================================
-- STOP CURRENT TWEEN
--==================================================

local function CancelTween()
    if ActiveTween then
        pcall(function()
            ActiveTween:Cancel()
        end)

        ActiveTween = nil
    end
end

--==================================================
-- RESET CHARACTER
--==================================================

local function ResetCharacter()
    CancelTween()

    local _, humanoid, root = GetLocalCharacter()

    if humanoid then
        pcall(function()
            humanoid.PlatformStand = false
        end)
    end

    if root then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

--==================================================
-- TWEEN TOWARD PLAYER
--==================================================

local function TweenTowardPlayer(targetPlayer)
    if not IsValidPlayer(targetPlayer) then
        return false
    end

    local _, humanoid, myRoot = GetLocalCharacter()
    local _, _, targetRoot = GetCharacter(targetPlayer)

    if not humanoid or not myRoot or not targetRoot then
        return false
    end

    -- Target's CURRENT position.
    -- This is intentionally recalculated every update.
    local targetCFrame =
        targetRoot.CFrame * CFrame.new(0, 0, -FOLLOW_DISTANCE)

    local distance = (myRoot.Position - targetCFrame.Position).Magnitude

    if distance < 1 then
        return true
    end

    local tweenTime = math.max(distance / TWEEN_SPEED, 0.03)

    -- Keep each tween short so we can constantly
    -- update the destination when the player moves.
    tweenTime = math.min(tweenTime, 0.15)

    pcall(function()
        humanoid.PlatformStand = true
    end)

    pcall(function()
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end)

    CancelTween()

    ActiveTween = TweenService:Create(
        myRoot,
        TweenInfo.new(
            tweenTime,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    ActiveTween:Play()

    return true
end

--==================================================
-- WAR MODE
--==================================================

local function StartWar()
    if WarEnabled then
        return
    end

    -- Make sure RACE is off
    RaceEnabled = false
    CurrentRaceTarget = nil

    WarEnabled = true

    task.spawn(function()

        while WarEnabled do

            local players = {}

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    table.insert(players, player)
                end
            end

            for _, targetPlayer in ipairs(players) do

                if not WarEnabled then
                    break
                end

                if IsValidPlayer(targetPlayer) then

                    CurrentWarTarget = targetPlayer

                    local startTime = tick()

                    -- Continuously follow this player
                    -- for WAR_FOLLOW_TIME seconds.
                    while WarEnabled
                        and IsValidPlayer(targetPlayer)
                        and (tick() - startTime) < WAR_FOLLOW_TIME do

                        TweenTowardPlayer(targetPlayer)

                        task.wait(UPDATE_INTERVAL)
                    end

                    CancelTween()

                    CurrentWarTarget = nil

                    -- Small pause before next player
                    task.wait(0.05)
                end
            end

            -- Restart the player list after completing
            -- the whole cycle.
            task.wait(0.05)
        end

        CurrentWarTarget = nil
        ResetCharacter()
    end)
end

local function StopWar()
    WarEnabled = false
    CurrentWarTarget = nil

    CancelTween()
    ResetCharacter()
end

--==================================================
-- RACE MODE
--==================================================

local function StartRace()
    if RaceEnabled then
        return
    end

    -- Make sure WAR is off
    WarEnabled = false
    CurrentWarTarget = nil

    RaceEnabled = true

    task.spawn(function()

        -- Find the nearest player ONCE when Race starts.
        CurrentRaceTarget = GetNearestPlayer()

        while RaceEnabled do

            -- If the current target disappears/dies,
            -- find another nearest player.
            if not IsValidPlayer(CurrentRaceTarget) then

                CancelTween()

                CurrentRaceTarget = GetNearestPlayer()

                if not CurrentRaceTarget then
                    task.wait(0.2)
                    continue
                end
            end

            -- Continuously update the destination
            -- using the target's CURRENT position.
            if CurrentRaceTarget then
                TweenTowardPlayer(CurrentRaceTarget)
            end

            task.wait(UPDATE_INTERVAL)
        end

        CurrentRaceTarget = nil

        ResetCharacter()
    end)
end

local function StopRace()
    RaceEnabled = false
    CurrentRaceTarget = nil

    CancelTween()
    ResetCharacter()
end

