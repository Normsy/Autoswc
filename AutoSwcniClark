--// WAR + RACE MODE
--// Standalone Player Movement Script

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local TWEEN_SPEED = 90
local ANCHOR_TIME = 2
local DISTANCE_FROM_PLAYER = 3

local warEnabled = false
local raceEnabled = false

local stopRequested = false
local currentTween = nil
local currentWeld = nil
local currentTarget = nil

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
    local character = LocalPlayer.Character

    if not character then
        return nil, nil, nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        return nil, nil, nil
    end

    return character, root, humanoid
end

--==================================================
-- PLAYER ROOT
--==================================================

local function getPlayerRoot(player)
    if not player or player == LocalPlayer then
        return nil
    end

    local character = player.Character

    if not character then
        return nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health <= 0 then
        return nil
    end

    return root
end

--==================================================
-- CLEANUP
--==================================================

local function releaseCharacter()
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)

        currentTween = nil
    end

    if currentWeld then
        pcall(function()
            currentWeld:Destroy()
        end)

        currentWeld = nil
    end

    currentTarget = nil

    local _, root, humanoid = getCharacter()

    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
    end
end

--==================================================
-- GET NEAREST PLAYER
--==================================================

local function getNearestPlayer()
    local _, myRoot = getCharacter()

    if not myRoot then
        return nil
    end

    local nearestPlayer = nil
    local nearestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            local targetRoot = getPlayerRoot(player)

            if targetRoot then

                local distance =
                    (myRoot.Position - targetRoot.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestPlayer = player
                end
            end
        end
    end

    return nearestPlayer
end

--==================================================
-- CREATE ATTACHMENT
--==================================================

local function attachToPlayer(targetPlayer)
    local _, root, humanoid = getCharacter()

    if not root or not humanoid then
        return false
    end

    local targetRoot = getPlayerRoot(targetPlayer)

    if not targetRoot then
        return false
    end

    currentTarget = targetPlayer

    -- Put us beside the target
    root.CFrame =
        targetRoot.CFrame * CFrame.new(0, 0, -DISTANCE_FROM_PLAYER)

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    humanoid.PlatformStand = true

    -- Attach to target
    local weld = Instance.new("WeldConstraint")

    weld.Name = "RaceModeWeld"
    weld.Part0 = root
    weld.Part1 = targetRoot
    weld.Parent = root

    currentWeld = weld

    -- Anchor while attached
    root.Anchored = true

    return true
end

--==================================================
-- RACE MODE
--==================================================

local function startRaceMode()

    if raceEnabled then
        return
    end

    raceEnabled = true

    task.spawn(function()

        while raceEnabled do

            local target = getNearestPlayer()

            if not target then
                currentTarget = nil
                task.wait(0.5)
                continue
            end

            -- Attach to nearest player
            if not attachToPlayer(target) then
                task.wait(0.5)
                continue
            end

            -- Stay attached forever while target is valid
            while raceEnabled do

                local targetRoot = getPlayerRoot(target)

                if not targetRoot then
                    break
                end

                -- Make sure the weld still exists
                if not currentWeld or not currentWeld.Parent then
                    break
                end

                task.wait(0.2)
            end

            -- Release current player
            if currentWeld then
                pcall(function()
                    currentWeld:Destroy()
                end)

                currentWeld = nil
            end

            local _, root, humanoid = getCharacter()

            if root then
                root.Anchored = false
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end

            if humanoid then
                humanoid.PlatformStand = false
            end

            currentTarget = nil

            -- Immediately find another nearest player
            task.wait(0.05)
        end

        releaseCharacter()
    end)
end

local function stopRaceMode()

    raceEnabled = false

    releaseCharacter()
end

--==================================================
-- WAR MODE
--==================================================

local function tweenToPlayer(targetPlayer)

    if not warEnabled then
        return false
    end

    local _, root, humanoid = getCharacter()

    if not root or not humanoid then
        return false
    end

    local targetRoot = getPlayerRoot(targetPlayer)

    if not targetRoot then
        return false
    end

    currentTarget = targetPlayer

    local targetCFrame =
        targetRoot.CFrame * CFrame.new(0, 0, -DISTANCE_FROM_PLAYER)

    local distance =
        (root.Position - targetCFrame.Position).Magnitude

    local tweenTime =
        math.max(distance / TWEEN_SPEED, 0.1)

    humanoid.PlatformStand = true
    root.Anchored = true

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    currentTween = TweenService:Create(
        root,
        TweenInfo.new(
            tweenTime,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    currentTween:Play()

    local finished = false

    local connection

    connection = currentTween.Completed:Connect(function()
        finished = true
    end)

    while not finished do

        if not warEnabled then
            currentTween:Cancel()

            connection:Disconnect()
            currentTween = nil

            root.Anchored = false
            humanoid.PlatformStand = false

            return false
        end

        if not getPlayerRoot(targetPlayer) then
            currentTween:Cancel()

            connection:Disconnect()
            currentTween = nil

            root.Anchored = false
            humanoid.PlatformStand = false

            return false
        end

        task.wait()
    end

    connection:Disconnect()
    currentTween = nil

    if not warEnabled then
        return false
    end

    targetRoot = getPlayerRoot(targetPlayer)

    if not targetRoot then
        root.Anchored = false
        humanoid.PlatformStand = false

        return false
    end

    root.CFrame =
        targetRoot.CFrame * CFrame.new(0, 0, -DISTANCE_FROM_PLAYER)

    -- Attach
    local weld = Instance.new("WeldConstraint")

    weld.Name = "WarModeWeld"
    weld.Part0 = root
    weld.Part1 = targetRoot
    weld.Parent = root

    currentWeld = weld

    root.Anchored = true

    local startTime = os.clock()

    while os.clock() - startTime < ANCHOR_TIME do

        if not warEnabled then
            break
        end

        if not getPlayerRoot(targetPlayer) then
            break
        end

        task.wait()
    end

    if currentWeld == weld then
        currentWeld = nil

        pcall(function()
            weld:Destroy()
        end)
    end

    root.Anchored = false

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    humanoid.PlatformStand = false

    currentTarget = nil

    return true
end

local function startWarMode()

    if warEnabled then
        return
    end

    warEnabled = true

    task.spawn(function()

        local players = {}

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(players, player)
            end
        end

        table.sort(players, function(a, b)
            return a.UserId < b.UserId
        end)

        for _, player in ipairs(players) do

            if not warEnabled then
                break
            end

            if Players:FindFirstChild(player.Name) then
                tweenToPlayer(player)

                if warEnabled then
                    task.wait(0.15)
                end
            end
        end

        warEnabled = false
        releaseCharacter()
    end)
end

local function stopWarMode()

    warEnabled = false

    releaseCharacter()
end

