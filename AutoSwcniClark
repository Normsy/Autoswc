--// AUTO TWEEN PLAYERS
--// Standalone script
--// Tween -> Attach/Anchor for 2 seconds -> Release -> Next Player

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

--==================================================
-- SETTINGS
--==================================================

local TWEEN_SPEED = 90
local ANCHOR_TIME = 2
local DISTANCE_FROM_PLAYER = 3

local autoTween = false
local stopRequested = false
local currentTween = nil
local currentWeld = nil

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
    local character = LocalPlayer.Character

    if not character then
        return nil, nil, nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        return nil, nil, nil
    end

    return character, root, humanoid
end

--==================================================
-- TARGET CHECK
--==================================================

local function getTargetRoot(player)
    if not player or player == LocalPlayer then
        return nil
    end

    local character = player.Character

    if not character then
        return nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health <= 0 then
        return nil
    end

    return root
end

--==================================================
-- STOP CURRENT MOVEMENT
--==================================================

local function stopCurrentTween()
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)

        currentTween = nil
    end

    if currentWeld then
        pcall(function()
            currentWeld:Destroy()
        end)

        currentWeld = nil
    end

    local _, root, humanoid = getCharacter()

    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    if humanoid then
        humanoid.PlatformStand = false
    end
end

--==================================================
-- TWEEN TO PLAYER
--==================================================

local function tweenToPlayer(targetPlayer)
    if stopRequested or not autoTween then
        return false
    end

    local _, root, humanoid = getCharacter()

    if not root or not humanoid then
        return false
    end

    local targetRoot = getTargetRoot(targetPlayer)

    if not targetRoot then
        return false
    end

    -- Stay 3 studs in front of the target
    local targetCFrame =
        targetRoot.CFrame * CFrame.new(0, 0, -DISTANCE_FROM_PLAYER)

    local distance =
        (root.Position - targetCFrame.Position).Magnitude

    local tweenTime =
        math.max(distance / TWEEN_SPEED, 0.1)

    -- Prevent normal character movement
    humanoid.PlatformStand = true

    root.Anchored = true

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    -- Create tween
    currentTween = TweenService:Create(
        root,
        TweenInfo.new(
            tweenTime,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        ),
        {
            CFrame = targetCFrame
        }
    )

    currentTween:Play()

    local completed = false

    local connection
    connection = currentTween.Completed:Connect(function()
        completed = true
    end)

    -- Wait for tween
    while not completed do
        if stopRequested or not autoTween then
            currentTween:Cancel()
            connection:Disconnect()
            currentTween = nil

            root.Anchored = false
            humanoid.PlatformStand = false

            return false
        end

        -- Target left / died
        if not getTargetRoot(targetPlayer) then
            currentTween:Cancel()
            connection:Disconnect()
            currentTween = nil

            root.Anchored = false
            humanoid.PlatformStand = false

            return false
        end

        task.wait()
    end

    connection:Disconnect()
    currentTween = nil

    if stopRequested or not autoTween then
        root.Anchored = false
        humanoid.PlatformStand = false
        return false
    end

    -- Make sure we are exactly at the target position
    targetRoot = getTargetRoot(targetPlayer)

    if not targetRoot then
        root.Anchored = false
        humanoid.PlatformStand = false
        return false
    end

    root.CFrame =
        targetRoot.CFrame * CFrame.new(0, 0, -DISTANCE_FROM_PLAYER)

    --==================================================
    -- ATTACH TO PLAYER
    --==================================================

    local weld = Instance.new("WeldConstraint")

    weld.Name = "AutoTweenPlayerWeld"
    weld.Part0 = root
    weld.Part1 = targetRoot
    weld.Parent = root

    currentWeld = weld

    -- Keep character anchored for 2 seconds
    root.Anchored = true

    local startTime = os.clock()

    while os.clock() - startTime < ANCHOR_TIME do
        if stopRequested or not autoTween then
            break
        end

        -- If target disappears, stop attaching
        if not getTargetRoot(targetPlayer) then
            break
        end

        task.wait()
    end

    --==================================================
    -- RELEASE
    --==================================================

    if currentWeld == weld then
        currentWeld = nil

        pcall(function()
            weld:Destroy()
        end)
    end

    root.Anchored = false

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    humanoid.PlatformStand = false

    return true
end

--==================================================
-- GET PLAYERS
--==================================================

local function getPlayers()
    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player)
        end
    end

    -- Consistent order
    table.sort(list, function(a, b)
        return a.UserId < b.UserId
    end)

    return list
end

--==================================================
-- AUTO TWEEN LOOP
--==================================================

local function startAutoTween()
    if autoTween then
        return
    end

    autoTween = true
    stopRequested = false

    task.spawn(function()

        while autoTween and not stopRequested do

            local playerList = getPlayers()

            if #playerList == 0 then
                task.wait(1)
                continue
            end

            for _, targetPlayer in ipairs(playerList) do

                if not autoTween or stopRequested then
                    break
                end

                -- Skip players who left
                if Players:FindFirstChild(targetPlayer.Name) then

                    tweenToPlayer(targetPlayer)

                    -- Small delay before next player
                    if autoTween and not stopRequested then
                        task.wait(0.15)
                    end
                end
            end

            -- Finished everyone
            -- Stop here instead of automatically restarting
            break
        end

        autoTween = false
        stopCurrentTween()
    end)
end

local function stopAutoTween()
    autoTween = false
    stopRequested = true

    stopCurrentTween()
end

